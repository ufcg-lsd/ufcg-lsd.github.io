
# syntax=docker/dockerfile:1.7

FROM node:22.13.0 AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN --mount=type=secret,id=contentful_env \
    set -a \
    && . /run/secrets/contentful_env \
    && set +a \
    && npm run build

FROM nginx:1.27-alpine AS runner

COPY nginx.static.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/out /usr/share/nginx/html

RUN mkdir -p /var/cache/nginx /var/run \
    && chgrp -R 0 /var/cache/nginx /var/run /usr/share/nginx/html \
    && chmod -R g=u /var/cache/nginx /var/run /usr/share/nginx/html

RUN sed -i 's/^user  nginx;/#user nginx;/' /etc/nginx/nginx.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
